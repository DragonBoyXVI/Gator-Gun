[sub_resource type="GDScript" id="GDScript_ua5yu"]
script/source = "@tool
extends SoldierCharacter;


@export var _movement: VelocityFloating2D;
@export var _rotation: RotationControl;

@onready var _model: Node2D = $Sprite2D;


func _physics_process( delta: float ) -> void:
	
	var move_vector: Vector2 = InputNames.Move.get_vector();
	_movement.accelerate_in_direction( delta, move_vector );
	_movement.move_character_body( self );
	
	var mouse_direction: float = global_position.angle_to_point( get_global_mouse_position() );
	_rotation.rotate_to_direction( delta, mouse_direction );
	_model.rotation = _rotation.get_current_rotation();
	
	pass;
"

